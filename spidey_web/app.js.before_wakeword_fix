const commandBox =
    $("command");


async function sendTypedCommand(
    command
) {

    if (!command) {
        return;
    }

    log(
        "You: " +
        command
    );

    setState(
        "THINKING",
        "Processing your command..."
    );

    try {

        const response =
            await fetch(
                "/api/command",
                {
                    method: "POST",

                    headers: {
                        "Content-Type":
                            "application/json"
                    },

                    body: JSON.stringify({
                        command: command
                    })
                }
            );


        const data =
            await response.json();


        if (data.message) {

            log(
                "SPIDEY: " +
                data.message
            );
        }


        setState(
            "STANDBY",
            data.message ||
            "Command completed."
        );


    } catch (error) {

        console.error(
            "Typed command error:",
            error
        );

        log(
            "SPIDEY: Command connection failed."
        );

        setState(
            "STANDBY",
            "Command connection failed."
        );
    }
}


if (commandBox) {

