function uptime() {

    const seconds =
        Math.floor(
            (
                performance.now() -
                state.started
            ) /
            1000
        );


    const h =
        String(
            Math.floor(
                seconds / 3600
            )
        ).padStart(
            2,
            "0"
        );


    const m =
        String(
            Math.floor(
                (
                    seconds % 3600
                ) /
                60
            )
        ).padStart(
            2,
            "0"
        );


    const sec =
        String(
            seconds % 60
        ).padStart(
            2,
            "0"
        );


    $("uptime").textContent =
        `${h}:${m}:${sec}`;
}


