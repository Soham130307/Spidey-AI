// then enhance it safely.

const originalSetState =
    window.setState;


window.setState =
    function (
        name,
        message = ""
    ) {

        // Run original HUD state handler.

        if (
            typeof originalSetState ===
            "function"
        ) {

            originalSetState(
                name,
                message
            );
        }


        const clean =
            String(
                name || ""
            ).toUpperCase();


        // ----------------------------------------------------
        // THINKING
        // ----------------------------------------------------

        if (
            clean ===
            "THINKING"
        ) {

            showThinking();

        } else {

            hideThinking();
        }
    };


