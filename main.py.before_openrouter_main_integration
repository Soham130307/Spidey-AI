HUD_URL = "http://127.0.0.1:8765/api/state"


LAST_USER_COMMAND = ""

def update_hud(state, message=None):

    global LAST_USER_COMMAND

    if message and message.startswith("You:"):
        LAST_USER_COMMAND = message[4:].strip()


    try:

        import urllib.request
        import json

        # Keep the state machine compatible with the existing
        # HUD server while also sending a readable activity line.
        hud_state = state

        if message:
            hud_state = f"{state}|{message}"

        user_command = ""

        if message and message.startswith("You:"):
            user_command = message[4:].strip()

        data = json.dumps({
            "state": hud_state,
            "user_command": user_command if user_command else LAST_USER_COMMAND,
            "spidey_message": message if message else ""
        }).encode("utf-8")

        request = urllib.request.Request(
            HUD_URL,
            data=data,
            headers={
                "Content-Type": "application/json"
            },
            method="POST"
        )

        urllib.request.urlopen(
            request,
            timeout=0.5
        )

    except Exception:
        # HUD may not be running.
        # Spidey continues working normally.
        pass

