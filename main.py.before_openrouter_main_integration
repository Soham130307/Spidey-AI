def speak_streaming_groq(prompt):
    """
    Stream Groq's response while pre-generating upcoming TTS audio
    in the background to minimize gaps between sentences.
    """

    import queue
    import threading
    import os

    sentence_queue = queue.Queue()
    full_response = []
    producer_error = [None]
    stop_event = threading.Event()

    def producer():
        try:
            buffer = ""

            for chunk in ai_router.stream_groq(prompt):

                if not chunk or stop_event.is_set():
                    continue

                full_response.append(chunk)
                buffer += chunk

                while True:

                    match = re.search(
                        r"(.+?[.!?])(?:\s+|$)",
                        buffer,
                        re.DOTALL
                    )

                    if not match:
                        break

                    sentence = match.group(1).strip()
                    buffer = buffer[match.end():]

                    if not sentence:
                        continue

                    filename = f"jarvis_{uuid.uuid4().hex}.mp3"

                    try:
                        # Generate this sentence's audio in the
                        # background while the previous sentence plays.
                        asyncio.run(
                            create_voice(
                                sentence,
                                filename
                            )
                        )

                        if stop_event.is_set():
                            try:
                                os.remove(filename)
                            except Exception:
                                pass
                            break

                        sentence_queue.put(
                            (sentence, filename)
                        )

                    except Exception:
                        try:
                            os.remove(filename)
                        except Exception:
                            pass
                        raise

            remaining = buffer.strip()

            if remaining and not stop_event.is_set():

                filename = f"jarvis_{uuid.uuid4().hex}.mp3"

                asyncio.run(
                    create_voice(
                        remaining,
                        filename
                    )
                )

                if not stop_event.is_set():
                    sentence_queue.put(
                        (remaining, filename)
                    )
                else:
                    try:
                        os.remove(filename)
                    except Exception:
                        pass

        except Exception as e:
            producer_error[0] = e

        finally:
            sentence_queue.put(None)

    print("AI STREAM: STARTING")

    thread = threading.Thread(
        target=producer,
        daemon=True
    )

    thread.start()

    try:

        if not pygame.mixer.get_init():
            pygame.mixer.init()

        while True:

            item = sentence_queue.get()

            if item is None:
                break

            sentence, filename = item

            if stop_event.is_set():
                try:
                    os.remove(filename)
                except Exception:
                    pass
                continue

            print(
                "AI STREAM: SPEAKING SENTENCE:",
                repr(sentence)
            )

            clear_chup()

            try:

                pygame.mixer.music.load(filename)
                pygame.mixer.music.play()

                update_hud(
                    "SPEAKING",
                    "Spidey is speaking..."
                )

                while pygame.mixer.music.get_busy():

                    if chup_requested():

                        print(
                            "SPIDEY: CHUP button pressed."
                        )

                        pygame.mixer.music.stop()
                        clear_chup()
                        stop_event.set()

                        update_hud(
                            "LISTENING",
                            "Speech stopped ? listening..."
                        )

                        break

                    time.sleep(0.01)

            finally:

                try:
                    pygame.mixer.music.stop()
                except Exception:
                    pass

                try:
                    os.remove(filename)
                except Exception:
                    pass

            if stop_event.is_set():
                break

    finally:
        stop_event.set()
        thread.join(timeout=2)

    if producer_error[0] is not None:
        raise producer_error[0]

    return "".join(full_response).strip()


