def ask_gemini(prompt):
    """
    Send a request to Gemini using a fresh client.

    A fresh client is intentionally created for each request to
    avoid stale/intermittent authorization state in the long-running
    SPIDEY process.
    """

    fresh_gemini_client = genai.Client(
        api_key=os.environ["GEMINI_API_KEY"]
    )

    response = fresh_gemini_client.models.generate_content(
        model=GEMINI_MODEL,
        contents=prompt,
        config={
            "temperature": 0.3,
            "max_output_tokens": 1000
        }
    )

    return response.text.strip()


