def try_productivity_command(user_input):
    """
    Detect and execute SPIDEY productivity commands.

    Returns:
        True  -> command was handled
        False -> command was not a productivity command
    """

    raw = str(user_input).strip()

    if not raw:
        return False

    lowered = raw.lower()

    meeting_prefixes = [
        "summarize meeting notes",
        "summarise meeting notes",
        "summarize these meeting notes",
        "summarise these meeting notes",
        "summarize my meeting notes",
        "summarise my meeting notes",
        "meeting notes summary",
        "meeting summary",
    ]

    action_prefixes = [
        "generate action items",
        "create action items",
        "extract action items",
        "find action items",
        "action items from meeting",
        "make action items",
    ]

    matched_type = None
    prefix_used = None

    for prefix in meeting_prefixes:
        if lowered.startswith(prefix):
            matched_type = "meeting"
            prefix_used = prefix
            break

    if matched_type is None:
        for prefix in action_prefixes:
            if lowered.startswith(prefix):
                matched_type = "actions"
                prefix_used = prefix
                break

    if matched_type is None:
        return False

    # Remove the command prefix while preserving the original
    # capitalization of the user's notes.
    notes = raw[len(prefix_used):].strip()

    # Remove common separators.
    notes = notes.lstrip(":,- ")

    if not notes:
        if matched_type == "meeting":
            speak(
                "Please provide the meeting notes after "
                "the command. For example, summarize meeting "
                "notes: Rahul will finish the API by Friday."
            )
        else:
            speak(
                "Please provide the meeting notes after "
                "the command. For example, generate action "
                "items: Rahul will finish the API by Friday."
            )

        return True

    try:
        update_hud("THINKING", "Working on your productivity task...")

        if matched_type == "meeting":
            print("\nSPIDEY PRODUCTIVITY: MEETING NOTES SUMMARY")
            result = productivity.summarize_meeting_notes(
                notes,
                ask_gemini,
            )
        else:
            print("\nSPIDEY PRODUCTIVITY: ACTION ITEMS")
            result = productivity.generate_action_items(
                notes,
                ask_gemini,
            )

        print("\n" + result + "\n")

        update_hud("SPEAKING", "Productivity result ready")
        speak(result)

        return True

    except Exception as e:
        print("SPIDEY PRODUCTIVITY ERROR:", e)

        update_hud("SPEAKING", "Productivity task failed")

        speak(
            "I could not complete that productivity task. "
            "Please check the Gemini connection and try again."
        )

        return True



