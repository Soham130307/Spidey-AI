def wait_for_space():
    """Wait for SPACE or a typed command from the HUD."""

    while not space_held():

        if os.path.exists(TYPED_COMMAND_FILE):
            return False

        time.sleep(0.02)

    return True


def listen_for_wake_word(duration=WAKE_LISTEN_TIME):
    """
    Push-to-talk wake listener.

    SPACE DOWN  -> recording starts
    SPACE HELD  -> recording continues
    SPACE UP    -> recording stops
    """

    try:
        import keyboard
        import numpy as np

        if not wait_for_space():

            typed_command = pop_typed_command()

            if typed_command:

                print(
                    "SPIDEY: TYPED STANDBY INPUT:",
                    repr(typed_command)
                )

                return "__TYPED__" + typed_command

            return ""

        print("WAKE MIC: SPACE is held - recording...")

        chunks = []

        CHUNK_SECONDS = 0.05
        blocksize = int(SAMPLE_RATE * CHUNK_SECONDS)

        # Safety limit: maximum 10 seconds.
        MAX_SECONDS = 10.0
        max_chunks = int(MAX_SECONDS / CHUNK_SECONDS)

        with sd.InputStream(
            samplerate=SAMPLE_RATE,
            channels=1,
            dtype="int16",
            blocksize=blocksize,
            latency="low"
        ) as stream:

            for _ in range(max_chunks):

                data, overflowed = stream.read(blocksize)

                if overflowed:
                    print("WAKE MIC: input overflow.")

                chunks.append(data.copy())

                # ==============================
                # SPACE RELEASE = STOP RECORDING
                # ==============================
                if not keyboard.is_pressed("space"):
                    print("WAKE MIC: SPACE released - recording stopped.")
                    break

        if not chunks:
            print("WAKE MIC: no audio captured.")
            return ""

        audio = np.concatenate(chunks).flatten()

        max_level = int(np.max(np.abs(audio))) if len(audio) else 0

        rms = float(
            np.sqrt(
                np.mean(
                    audio.astype(np.float32) ** 2
                )
            )
        ) if len(audio) else 0.0

        seconds = len(audio) / SAMPLE_RATE

        print(
            f"WAKE MIC: captured {seconds:.2f}s "
            f"max={max_level} RMS={rms:.0f}"
        )

        if max_level == 0:
            print("WAKE MIC: recording is silent.")
            return ""

        audio_data = sr.AudioData(
            audio.tobytes(),
            SAMPLE_RATE,
            2
        )

        try:

            text = recognizer.recognize_google(
                audio_data,
                language="en-IN"
            )

            text = text.strip()

            print(
                "WAKE RECOGNITION:",
                repr(text)
            )

            return text

        except sr.UnknownValueError:

            print("WAKE: Speech not understood.")

            return ""

        except sr.RequestError as e:

            print(
                "WAKE: Speech recognition unavailable:",
                e
            )

            return ""

    except Exception as e:

        print(
            "Wake microphone error:",
            e
        )

        return ""




