def listen(duration=COMMAND_LISTEN_TIME):

    print("\nSPIDEY: Listening...")

    try:

        # ----------------------------------------------------
        # FAST + RELIABLE MICROPHONE LISTENING
        # ----------------------------------------------------
        # We keep sounddevice + Google recognition, but:
        # 1. Measure the room noise first.
        # 2. Use a dynamic speech threshold.
        # 3. Start capturing immediately.
        # 4. Stop shortly after the user finishes speaking.
        #
        # This avoids the old fixed 3-second recording problem
        # that was causing missed commands and repeated attempts.
        # ----------------------------------------------------

        CHUNK_SECONDS = 0.10
        NOISE_SECONDS = 0.25
        END_SILENCE = 0.90
        MIN_SPEECH_SECONDS = 0.30
        MIN_RECORD_SECONDS = 0.35

        max_seconds = max(
            2.5,
            float(duration)
        )

        blocksize = int(
            SAMPLE_RATE *
            CHUNK_SECONDS
        )

        frames = []

        stream_start = time.monotonic()
        speech_started = False
        speech_start_time = None
        silence_started = None

        # ----------------------------------------------------
        # OPEN MICROPHONE
        # ----------------------------------------------------

        with sd.InputStream(
            samplerate=SAMPLE_RATE,
            channels=1,
            dtype="int16",
            blocksize=blocksize,
            latency="low"
        ) as stream:

            # ------------------------------------------------
            # QUICK NOISE CALIBRATION
            # ------------------------------------------------

            noise_levels = []

            calibration_end = (
                time.monotonic()
                +
                NOISE_SECONDS
            )

            while (
                time.monotonic()
                <
                calibration_end
            ):

                data, overflowed = stream.read(
                    blocksize
                )

                level = float(
                    (
                        (
                            data.astype(
                                "float32"
                            ) ** 2
                        ).mean()
                    ) ** 0.5
                )

                noise_levels.append(
                    level
                )

            if noise_levels:

                noise_floor = (
                    sum(noise_levels)
                    /
                    len(noise_levels)
                )

            else:

                noise_floor = 80.0

            # Dynamic threshold.
            # Keep sensible minimums so very quiet microphones
            # still detect normal speech.
            START_THRESHOLD = max(
                180.0,
                noise_floor * 2.2
            )

            SILENCE_THRESHOLD = max(
                120.0,
                noise_floor * 1.35
            )

            print(
                "MIC:",
                f"noise={noise_floor:.0f}",
                f"start={START_THRESHOLD:.0f}",
                f"silence={SILENCE_THRESHOLD:.0f}"
            )

            # ------------------------------------------------
            # LISTEN
            # ------------------------------------------------

            while (
                time.monotonic() -
                stream_start
            ) < max_seconds:

                data, overflowed = stream.read(
                    blocksize
                )

                frames.append(
                    data.copy()
                )

                level = float(
                    (
                        (
                            data.astype(
                                "float32"
                            ) ** 2
                        ).mean()
                    ) ** 0.5
                )

                now = time.monotonic()

                # --------------------------------------------
                # SPEECH START
                # --------------------------------------------

                if level >= START_THRESHOLD:

                    if not speech_started:

                        speech_started = True

                        speech_start_time = now

                        print(
                            "MIC: speech detected"
                        )

                    silence_started = None

                    continue

                # --------------------------------------------
                # AFTER SPEECH HAS STARTED
                # --------------------------------------------

                if speech_started:

                    if level < SILENCE_THRESHOLD:

                        if silence_started is None:

                            silence_started = now

                        elif (
                            (
                                now -
                                silence_started
                            ) >= END_SILENCE
                            and
                            speech_start_time is not None
                            and
                            now -
                            speech_start_time
                            >= MIN_SPEECH_SECONDS
                        ):

                            break

                    else:

                        silence_started = None

                # --------------------------------------------
                # NO SPEECH
                # --------------------------------------------

                elif (
                    now -
                    stream_start
                    >=
                    NOISE_SECONDS +
                    1.5
                ):

                    # Don't sit there forever when nobody spoke.
                    break


        # ----------------------------------------------------
        # NO AUDIO
        # ----------------------------------------------------

        if not frames:

            return ""


        # ----------------------------------------------------
        # REMOVE INITIAL CALIBRATION AUDIO
        # ----------------------------------------------------
        # The first NOISE_SECONDS are calibration only and
        # should not be sent to Google.
        # ----------------------------------------------------

        calibration_frames = int(
            NOISE_SECONDS /
            CHUNK_SECONDS
        )

        if len(frames) > calibration_frames:

            frames = frames[
                calibration_frames:
            ]


        if not frames:

            return ""


        # ----------------------------------------------------
        # BUILD AUDIO
        # ----------------------------------------------------

        audio = b"".join(
            frame.tobytes()
            for frame in frames
        )


        if len(audio) < (
            SAMPLE_RATE *
            2 *
            MIN_RECORD_SECONDS
        ):

            return ""


        audio_data = sr.AudioData(
            audio,
            SAMPLE_RATE,
            2
        )


        # ----------------------------------------------------
        # GOOGLE SPEECH RECOGNITION
        # ----------------------------------------------------

        try:

            text = recognizer.recognize_google(
                audio_data,
                language="en-IN"
            )

            text = text.strip()

            if text:

                print(
                    "You:",
                    text
                )

                return text

            return ""


        except sr.UnknownValueError:

            print(
                "SPIDEY: I couldn't understand you."
            )

            return ""


        except sr.RequestError as e:

            print(
                "SPIDEY: Speech recognition unavailable:",
                e
            )

            return ""


    except Exception as e:

        print(
            "Microphone error:",
            e
        )

        return ""


