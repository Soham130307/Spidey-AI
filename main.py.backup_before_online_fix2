if __name__ == "__main__":

    import subprocess
    import sys
    from pathlib import Path

    hud_process = None

    hud_script = (
        Path(__file__).parent
        / "spidey_web"
        / "run_spidey_hud_native.py"
    )

    print()
    print("Starting SPIDEY HUD...")
    print()

    try:

        hud_process = subprocess.Popen(
            [
                sys.executable,
                str(hud_script)
            ]
        )

        # Give the HUD server a moment to start.
        time.sleep(0.5)

        run_spidey()

    except KeyboardInterrupt:

        print()
        print("SPIDEY interrupted by user.")

    except Exception as e:

        print()
        print("SPIDEY error:", e)

    finally:

        print()
        print("Stopping SPIDEY HUD...")

        if hud_process is not None:

            try:

                if hud_process.poll() is None:

                    hud_process.terminate()

                    try:

                        hud_process.wait(
                            timeout=3
                        )

                    except subprocess.TimeoutExpired:

                        print(
                            "HUD did not stop normally. Forcing shutdown..."
                        )

                        hud_process.kill()

                        hud_process.wait(
                            timeout=2
                        )

            except Exception as e:

                print(
                    "HUD shutdown error:",
                    e
                )

        print("SPIDEY OFFLINE.")

















