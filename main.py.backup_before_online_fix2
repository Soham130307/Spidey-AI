def middle_finger_gesture():
    global gesture_running
    gesture_running = True
    from mediapipe.tasks import python
    from mediapipe.tasks.python import vision

    model_path = os.path.join(
        os.path.dirname(os.path.abspath(__file__)),
        "models",
        "hand_landmarker.task"
    )

    base_options = python.BaseOptions(
        model_asset_path=model_path
    )

    options = vision.HandLandmarkerOptions(
        base_options=base_options,
        running_mode=vision.RunningMode.VIDEO,
        num_hands=1,
        min_hand_detection_confidence=0.6,
        min_hand_presence_confidence=0.6,
        min_tracking_confidence=0.6
    )

    cap = cv2.VideoCapture(0, cv2.CAP_DSHOW)

    if not cap.isOpened():
        print("SPIDEY: Could not open webcam for gesture detection.")
        return

    last_triggered = False
    cooldown = 2.0
    last_time = 0
    timestamp_ms = 0

    with vision.HandLandmarker.create_from_options(options) as landmarker:

        while gesture_running:
            success, frame = cap.read()

            if not success:
                continue

            frame = cv2.flip(frame, 1)

            rgb = cv2.cvtColor(frame, cv2.COLOR_BGR2RGB)

            mp_image = mp.Image(
                image_format=mp.ImageFormat.SRGB,
                data=rgb
            )

            timestamp_ms += 33

            results = landmarker.detect_for_video(
                mp_image,
                timestamp_ms
            )

            middle_up = False

            if results.hand_landmarks:

                hand = results.hand_landmarks[0]

                # -------------------------
                # Finger state detection
                # -------------------------

                index_up = hand[8].y < hand[6].y
                middle_up_state = hand[12].y < hand[10].y
                ring_up = hand[16].y < hand[14].y
                pinky_up = hand[20].y < hand[18].y

                # Middle finger must be UP
                # Index, ring and pinky must be DOWN
                middle_up = (
                    middle_up_state
                    and not index_up
                    and not ring_up
                    and not pinky_up
                )

                # -------------------------
                # Extra confirmation
                # -------------------------

                # Middle fingertip should be clearly
                # higher than the other curled fingertips
                if middle_up:

                    middle_tip_y = hand[12].y
                    index_tip_y = hand[8].y
                    ring_tip_y = hand[16].y
                    pinky_tip_y = hand[20].y

                    higher_than_index = (
                        middle_tip_y < index_tip_y
                    )

                    higher_than_ring = (
                        middle_tip_y < ring_tip_y
                    )

                    higher_than_pinky = (
                        middle_tip_y < pinky_tip_y
                    )

                    middle_up = (
                        higher_than_index
                        and higher_than_ring
                        and higher_than_pinky
                    )

            # -------------------------
            # Trigger
            # -------------------------

            if middle_up and not last_triggered:

                current_time = time.time()

                if current_time - last_time >= cooldown:

                    print("SPIDEY GESTURE: ÃƒÆ’Ã‚Â°Ãƒâ€¦Ã‚Â¸ÃƒÂ¢Ã¢â€šÂ¬Ã¢â‚¬Å“ÃƒÂ¢Ã¢â€šÂ¬Ã‚Â¢")

                    speak("TERI MAKA BHOSDA TERI MAKA LUND.")

                    last_time = current_time

                last_triggered = True

            # -------------------------
            # Reset after release
            # -------------------------

            if not middle_up:
                last_triggered = False

    cap.release()

def listen_for_wake_word(duration=WAKE_LISTEN_TIME):
    print("\nSPIDEY: Waiting for wake word...")

    try:
        CHUNK_SECONDS = 0.10
        NOISE_SECONDS = 0.25

        # Full wake listening window
        MAX_SECONDS = max(4.0, float(duration))

        END_SILENCE = 0.65
        MIN_SPEECH_SECONDS = 0.20

        blocksize = int(SAMPLE_RATE * CHUNK_SECONDS)

        frames = []
        speech_started = False
        speech_start_time = None
        silence_started = None

        stream_start = time.monotonic()

        with sd.InputStream(
            samplerate=SAMPLE_RATE,
            channels=1,
            dtype="int16",
            blocksize=blocksize,
            latency="low"
        ) as stream:

            # -----------------------------
            # NOISE CALIBRATION
            # -----------------------------
            noise_levels = []

            calibration_end = (
                time.monotonic() + NOISE_SECONDS
            )

            while time.monotonic() < calibration_end:

                data, overflowed = stream.read(blocksize)

                level = float(
                    ((data.astype("float32") ** 2).mean()) ** 0.5
                )

                noise_levels.append(level)

            noise_floor = (
                sum(noise_levels) / len(noise_levels)
                if noise_levels
                else 80.0
            )

            # More sensitive for wake words
            START_THRESHOLD = max(
                130.0,
                noise_floor * 1.7
            )

            SILENCE_THRESHOLD = max(
                90.0,
                noise_floor * 1.15
            )

            print(
                f"WAKE MIC: noise={noise_floor:.0f} "
                f"start={START_THRESHOLD:.0f} "
                f"silence={SILENCE_THRESHOLD:.0f}"
            )

            # -----------------------------
            # LISTEN FOR WAKE WORD
            # -----------------------------
            while (
                time.monotonic() - stream_start
                < MAX_SECONDS
            ):

                data, overflowed = stream.read(blocksize)

                frames.append(data.copy())

                level = float(
                    ((data.astype("float32") ** 2).mean()) ** 0.5
                )

                now = time.monotonic()

                # Speech detected
                if level >= START_THRESHOLD:

                    if not speech_started:
                        speech_started = True
                        speech_start_time = now

                        print(
                            "WAKE MIC: speech detected"
                        )

                    silence_started = None
                    continue

                # Speech has already started
                if speech_started:

                    if level < SILENCE_THRESHOLD:

                        if silence_started is None:
                            silence_started = now

                        elif (
                            now - silence_started >= END_SILENCE
                            and speech_start_time is not None
                            and now - speech_start_time
                            >= MIN_SPEECH_SECONDS
                        ):
                            print(
                                "WAKE MIC: speech ended"
                            )
                            break

                    else:
                        silence_started = None

        if not frames:
            return ""

        # Remove calibration audio
        calibration_frames = int(
            NOISE_SECONDS / CHUNK_SECONDS
        )

        if len(frames) > calibration_frames:
            frames = frames[calibration_frames:]

        if not frames:
            return ""

        # -----------------------------
        # CREATE AUDIO DATA
        # -----------------------------
        audio = b"".join(
            frame.tobytes()
            for frame in frames
        )

        if len(audio) < SAMPLE_RATE * 2 * 0.20:
            return ""

        audio_data = sr.AudioData(
            audio,
            SAMPLE_RATE,
            2
        )

        # -----------------------------
        # GOOGLE SPEECH RECOGNITION
        # -----------------------------
        try:

            text = recognizer.recognize_google(
                audio_data,
                language="en-IN"
            )

            text = text.strip()

            if text:
                print(
                    "WAKE RECOGNITION:",
                    repr(text)
                )

                return text

            return ""

        except sr.UnknownValueError:

            print(
                "WAKE: Speech not understood."
            )

            return ""

        except sr.RequestError as e:

            print(
                "WAKE: Speech recognition unavailable:",
                e
            )

            return ""

    except Exception as e:

        print(
            "Wake microphone error:",
            e
        )

        return ""   


def run_spidey():

    cleanup_old_audio()
    # Start hand gesture detection in background
    gesture_thread = threading.Thread(
